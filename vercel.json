{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "floridacoastal.co"
        }
      ],
      "destination": "https://www.floridacoastal.co/$1",
      "permanent": true
    },
    {
      "source": "/towns/north-redington-beach-v3.html",
      "destination": "/towns/redington-shores-v3.html",
      "permanent": false
    },
    {
      "source": "/towns/redington-beach-v3.html",
      "destination": "/towns/redington-shores-v3.html",
      "permanent": false
    },
    {
      "source": "/towns/valparaiso-v3.html",
      "destination": "/towns/niceville-v3.html",
      "permanent": false
    },
    {
      "source": "/towns/okaloosa-island-v3.html",
      "destination": "/towns/fort-walton-beach-v3.html",
      "permanent": false
    },
    {
      "source": "/towns/holly-hill-v3.html",
      "destination": "/towns/daytona-v3.html",
      "permanent": false
    },
    {
      "source": "/towns/south-daytona-v3.html",
      "destination": "/towns/daytona-v3.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/guides/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
